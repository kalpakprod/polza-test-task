# Скопировать в .env.local и подставить свои значения.
# Секретов в репозитории нет — только этот пример.
#
# Локальный Postgres в Docker:
#   DATABASE_URL=postgresql://polza:polza@localhost:5432/polza
# Supabase (бесплатный tier):
#   DATABASE_URL=postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
DATABASE_URL=postgresql://polza:polza@localhost:5432/polza
